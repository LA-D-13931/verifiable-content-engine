# ── 依赖与缓存 ────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc

# ── 可再生成的产物 ────────────────────────────────────────
# 58 张逐关截图：可随时用 `node tools/shots.js` 重生成，不入库（避免每次改动都产生二进制噪声）
shots/

# ── 自动备份 ─────────────────────────────────────────────
# 写文件前的自动备份（注意实际路径是 tools/_backup/，不是根目录下的 backups/）
backups/
tools/_backup/

# ── 编辑器 / 系统 ─────────────────────────────────────────
.DS_Store
Thumbs.db

# ── 临时文件 ─────────────────────────────────────────────
*.tmp
*.bak
*.orig
*~
*.swp

# ── 敏感信息（保险）──────────────────────────────────────
*.pem
*.key
.keys/
.env
.env.*
